---
import Icon from '../Icon.astro';
import { tramites, type TramiteId } from '../../data/sol';

interface Props {
	id: TramiteId;
	uid: string;
	variant?: 'card' | 'row';
}

const { id, uid, variant = 'row' } = Astro.props;
const tramite = tramites[id];
const tipId = `tip-${uid}`;
const search = `${tramite.titulo} ${tramite.ayuda} ${tramite.cuando}`;
---

<li
	class:list={['tramite group relative',variant === 'card' ? 'tramite-card' : 'tramite-row']}
	data-tramite
	data-id={id}
	data-titulo={tramite.titulo}
	data-perfiles={tramite.perfiles.join(' ')}
	data-buscar={search}
>
	{
		variant === 'card' ? (
			<button
				type="button"
				data-open
				aria-describedby={tipId}
				class="flex h-full w-full flex-col items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 pr-10 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-sunat-blue/40 hover:shadow-lg focus-visible:-translate-y-0.5 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-sky-500/50"
			>
				<span class="grid h-11 w-11 place-items-center rounded-xl bg-sky-50 text-sunat-blue transition group-hover:scale-105 dark:bg-sky-950/60 dark:text-sky-300">
					<Icon name={tramite.icon} size={22} />
				</span>
				<span class="text-sm font-bold leading-snug text-slate-900 dark:text-slate-100">{tramite.titulo}</span>
			</button>
		) : (
			<button
				type="button"
				data-open
				aria-describedby={tipId}
				class="flex min-h-11 w-full items-center gap-3 rounded-lg py-2 pl-3 pr-20 text-left text-sm font-medium text-slate-700 transition hover:bg-sky-50 hover:text-sunat-blue dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-sky-300"
			>
				<Icon name={tramite.icon} size={17} class="shrink-0 text-slate-400 dark:text-slate-500" />
				<span>{tramite.titulo}</span>
			</button>
		)
	}

	<div class:list={['absolute flex gap-0.5', variant === 'card' ? 'right-2 top-2 flex-col' : 'right-1.5 top-1/2 -translate-y-1/2']}>
		<button
			type="button"
			data-fav
			aria-pressed="false"
			aria-label={`Agregar «${tramite.titulo}» a favoritos`}
			title="Agregar a favoritos"
			class="sol-fav grid h-8 w-8 place-items-center rounded-full text-slate-400 transition hover:bg-amber-50 hover:text-amber-500 dark:text-slate-500 dark:hover:bg-amber-950/40"
		>
			<Icon name="star" size={16} />
		</button>
		<button
			type="button"
			data-info
			aria-expanded="false"
			aria-controls={tipId}
			aria-label={`¿Qué es «${tramite.titulo}»?`}
			class="grid h-8 w-8 place-items-center rounded-full text-slate-400 transition hover:bg-sky-50 hover:text-sunat-blue dark:text-slate-500 dark:hover:bg-slate-800 dark:hover:text-sky-300"
		>
			<Icon name="help-circle" size={16} />
		</button>
	</div>

	<div id={tipId} role="tooltip" class="tramite-tip">
		<p class="text-[11px] font-bold uppercase tracking-wider text-sky-300 dark:text-sunat-blue">¿Qué es?</p>
		<p class="mt-0.5">{tramite.ayuda}</p>
		<p class="mt-2 text-[11px] font-bold uppercase tracking-wider text-sky-300 dark:text-sunat-blue">¿Cuándo usarlo?</p>
		<p class="mt-0.5">{tramite.cuando}</p>
	</div>
</li>
